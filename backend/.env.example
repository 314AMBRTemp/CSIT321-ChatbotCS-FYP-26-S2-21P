# Local SQLite default. You can leave DATABASE_URL empty for local demo.
DATABASE_URL=sqlite:///askivy_hrms.db

# Example PostgreSQL/Supabase format for real deployment:
# DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

FLASK_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# Address the rule-based engine gives out when referring someone to HR. Keep in sync with
# the same variable in rasa/.env.
HR_CONTACT_EMAIL=hr@lumenvale.com

# Generates the opening paragraph of a policy answer (services/policy_explainer.py).
# The same key rasa/.env uses. Leave it unset and policy answers still work -- they fall
# back to the verbatim rules, just without the conversational opener.
ANTHROPIC_API_KEY=

# Optional overrides for the generated prose.
# ASKIVY_EXPLAIN_MODEL=claude-haiku-4-5-20251001
# ASKIVY_EXPLAIN_TIMEOUT=8

# Drafts a new policy from an admin's rough idea (services/policy_drafter.py). Same
# ANTHROPIC_API_KEY above; unset means the "Draft with AI" button returns an error, nothing
# else breaks. Defaults to a stronger model than the explainer -- this fires rarely (an
# admin drafting a policy), not on every employee question, so quality over speed.
# ASKIVY_DRAFT_MODEL=claude-opus-5
# ASKIVY_DRAFT_TIMEOUT=20
