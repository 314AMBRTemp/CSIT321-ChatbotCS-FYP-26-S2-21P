# Copy to rasa/.env and fill in. Never commit the real .env.
#
# IMPORTANT: `rasa train` and `rasa run` read these from the SHELL environment,
# not automatically from this file. Either export them in the terminal that runs
# Rasa, or load the file first (see CLAUDE.md "Stage 2").

# Anthropic key used by CompactLLMCommandGenerator via LiteLLM.
ANTHROPIC_API_KEY=sk-ant-...

# Rasa Pro licence. Free tier available at https://rasa.com/rasa-pro-developer-edition/
RASA_LICENSE=

# Where the custom actions reach the Flask HRMS API.
ASKIVY_API_URL=http://localhost:5000
ASKIVY_API_TIMEOUT=10
